+def fk_without_nonzero(model):
+    """Replace the NonZero/ScatterND/GatherND boolean-mask subgraph in fk_trt.onnx with static Select/Gather nodes."""
+    from openvino import opset13 as ops
+    node = {o.get_friendly_name(): o for o in model.get_ordered_ops()}
+    if not {"/Concat_11", "/Greater", "/Constant_48", "/ScatterND", "/Div", "/ArgMax", "/GatherND_1"} <= node.keys():
+        print("FK: NonZero patterns not found, using the exported graph as is")
+        return model
+    
+    sqrt = ops.sqrt(ops.maximum(node["/Concat_11"], ops.constant(np.float32(0))))
+    node["/ScatterND"].output(0).replace(ops.select(node["/Greater"], sqrt, node["/Constant_48"]).output(0))
+    node["/GatherND_1"].output(0).replace(ops.gather(node["/Div"], node["/ArgMax"], ops.constant(np.int64(1))).output(0))
+    model.validate_nodes_and_infer_types()
+
+    return model
+
+
+class OvPolicy:
+    """OpenVINO stand-in for the onnxruntime FK session (.run) and base/residual wrappers (__call__)."""
+
+    def __init__(self, core, path, device, precision, torch_device, cpu_threads=4, model=None):
+        config = {"INFERENCE_PRECISION_HINT": precision}
+        if cpu_threads > 0 and device.upper().startswith("CPU"):
+            config["INFERENCE_NUM_THREADS"] = str(cpu_threads)
+        print(f"Loading OpenVINO {path} on {device}/{precision}")
+        self.request = core.compile_model(path if model is None else model, device, config).create_infer_request()
+        self.device = torch_device
+
+    def run(self, _, feeds):
+        # Output tensors belong to the infer request and are overwritten by the next call.
+        return [out.copy() for out in self.request.infer(feeds).values()]
+
+    def __call__(self, obs):
+        f32 = lambda x: x.reshape(1, -1).cpu().numpy().astype(np.float32)
+        if isinstance(obs, dict):
+            feeds = {k: f32(obs[k]) for k in ("real_obs", "command_obs", "real_historical_obs_raw", "initial_noise")}
+        else:
+            feeds = {"obs": f32(obs)}
+        return torch.from_numpy(self.run(None, feeds)[0]).to(self.device)
+
