# Everything below is generated by running the notebook / the exporter. Only sources are committed:
# the notebook, fwam_ov.py, torch_ref_actions.py, README.md and utils/fwam_export/**.py

# FasterWAM clone + checkpoint + the exported IR sets (model/ir/{fp16,int8}/{vae,video,action,t5})
model/

# Python + Jupyter state
.venv/
__pycache__/
.ipynb_checkpoints/

# Run copies of the notebook produced by nbconvert / "Save and Export Notebook As"
*.executed.ipynb

# The helper module every openvino_notebooks notebook fetches into its own folder (copied from
# utils/notebook_utils.py, which is the tracked source)
notebook_utils.py

# Recorded evaluation packs the notebook loads - generated on first use by
# utils/fwam_export/make_eval_packs.py from the released checkpoint, the umT5 weights and the LIBERO
# episodes: eval_samples/eval_contexts/eval_latents/eval_proprio, ov_runtime_pack.npz and the
# re-derivable torch_ref_pack.npz
artifacts/

# The exporter's own outputs: torch reference dumps (make_ref.py) and one JSON log per export run
utils/fwam_export/artifacts/
utils/fwam_export/logs/
